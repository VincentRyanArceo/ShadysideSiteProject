@{
    ViewData["Title"] = "Home Page";
}

<!-- Sticky Parallax Container -->
<div class="position-relative" style="min-height: 200vh;">

    <!-- Fixed Background Carousel -->
    <div class="sticky-top w-100 vh-100 overflow-hidden" style="z-index: 1;">
        <div id="bandCarousel" class="carousel slide h-100" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100">
                    <img src="/images/BackPorch.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Band on the back porch">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/ChipLive.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Chip playing live">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/MichaelWendellLive.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Michael and Wendell live">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/MichaelWindow.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Michael by the window">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/RooftopPizzaSmoke.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Band hanging out on rooftop">
                </div>
                <div class="carousel-item h-100">
                    <img src="/images/WideShotLive.jpg" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(30%);" alt="Wide shot of live performance">
                </div>
            </div>

            <!-- Slide Navigation Buttons -->
            <button class="carousel-control-prev" type="button" data-bs-target="#bandCarousel" data-bs-slide="prev" style="z-index: 3;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bandCarousel" data-bs-slide="next" style="z-index: 3;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

    <!-- Scrollable Bio Overlay -->
    <div class="position-relative" style="z-index: 2; margin-top: -100vh; padding-top: 15vh; padding-bottom: 25vh;">
        
        <!-- Hero Title Hook -->
        <div class="container text-center text-white mb-5 pb-5">
            <h1 class="display-1 fw-bold tracking-wide">SHADYSIDE</h1>
            <p class="lead fw-normal mx-auto mb-4" style="max-width: 650px; font-size: 1.3rem;">
                The future is unwritten... but the band clearly has higher plans.
            </p>
            <a href="/Merch" class="btn btn-success btn-lg fw-bold shadow">
                <i class="bi bi-music-note-beamed me-2"></i> Get the New EP
            </a>
        </div>

