@model IEnumerable<ShadysideSiteProject.Models.MerchItem>

@{
    ViewData["Title"] = "Store & Merch";
}

<!-- Include Bootstrap Icons CDN for platform icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-5 text-white">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Official Store</h1>
        <p class="lead text-light">Support the band with digital downloads and exclusive merch.</p>
    </div>

    <!-- 1. Debug Alert for Fourthwall API -->
    @if (ViewBag.ApiMessage != null)
    {
        <div class="alert alert-warning shadow-sm mb-5 text-dark text-center" role="alert">
            <strong>API Status:</strong> @ViewBag.ApiMessage
        </div>
    }

    <!-- 2. TIER 1: NEW RELEASES -->
    <h3 class="fw-bold border-bottom border-secondary pb-2 mb-4">New Releases</h3>
    <div class="row justify-content-start mb-5 pb-4">
        @foreach (var item in Model.Where(i => i.IsDigitalDownload && i.IsNewRelease))
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card bg-dark border-secondary h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top p-3 rounded" alt="@item.Name">
                    }
                    <div class="card-body d-flex flex-column text-white">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-light small">@item.Description</p>
                        <h6 class="fw-bold text-success mb-3">$@item.Price.ToString("0.00")</h6>

                        @if (!string.IsNullOrEmpty(item.PreviewAudioPath))
                        {
                            <div class="mb-3">
                                <span class="badge bg-secondary mb-2">Track Preview</span>
                                <audio controls class="w-100" style="height: 40px;">
                                    <source src="@item.PreviewAudioPath" type="audio/mpeg">
                                </audio>
                            </div>
                        }

                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                @if (!string.IsNullOrEmpty(item.Mp3DownloadUrl))
                                {
                                    <a href="@item.Mp3DownloadUrl" download class="btn btn-purple fw-bold shadow-sm">
                                        <i class="bi bi-cloud-arrow-down-fill me-2"></i> Download MP3
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 2.5. TIER 1.5: CLASSIC CATALOG -->
    <h3 class="fw-bold border-bottom border-secondary pb-2 mb-4">Classic Catalog</h3>
    <div class="row justify-content-start mb-5 pb-4">
        @foreach (var item in Model.Where(i => i.IsDigitalDownload && !i.IsNewRelease))
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card bg-dark border-secondary h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top p-3 rounded" alt="@item.Name">
                    }
                    <div class="card-body d-flex flex-column text-white">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-light small">@item.Description</p>
                        <h6 class="fw-bold text-success mb-3">$@item.Price.ToString("0.00")</h6>

                        @if (!string.IsNullOrEmpty(item.PreviewAudioPath))
                        {
                            <div class="mb-3">
                                <span class="badge bg-secondary mb-2">Track Preview</span>
                                <audio controls class="w-100" style="height: 40px;">
                                    <source src="@item.PreviewAudioPath" type="audio/mpeg">
                                </audio>
                            </div>
                        }

                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                @if (!string.IsNullOrEmpty(item.Mp3DownloadUrl))
                                {
                                    <a href="@item.Mp3DownloadUrl" download class="btn btn-purple fw-bold shadow-sm">
                                        <i class="bi bi-cloud-arrow-down-fill me-2"></i> Download MP3
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 3. TIER 2: PHYSICAL MERCHANDISE -->
    <h3 class="fw-bold border-bottom border-secondary pb-2 mb-4">Apparel & Gear</h3>
    <div class="row justify-content-start mb-5">
        @foreach (var item in Model.Where(i => !i.IsDigitalDownload))
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card bg-dark border-secondary h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top p-3 rounded" alt="@item.Name" style="background-color: #f8f9fa;">
                    }
                    <div class="card-body d-flex flex-column text-white">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-light small">@item.Description</p>
                        <h6 class="fw-bold text-success mb-3">$@item.Price.ToString("0.00")</h6>

                        <div class="mt-auto">
                            <button class="btn btn-outline-light w-100 fw-bold shadow-sm">
                                <i class="bi bi-cart-plus me-2"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 4. Quick Links / Navigation Cards -->
    <div class="row justify-content-center g-4 mt-5 pt-4 border-top border-secondary">

        <!-- Home Card -->
        <div class="col-md-5">
            <a href="/" class="text-decoration-none">
                <div class="card nav-card bg-dark bg-opacity-75 border-secondary text-white h-100 text-center p-4 shadow-sm" style="backdrop-filter: blur(8px);">
                    <i class="bi bi-house-door display-4 mb-3" style="color: #a855f7;"></i>
                    <h3 class="h4 fw-bold">Home</h3>
                    <p class="text-light small mb-0">Return to the homepage to read the band bio and latest news.</p>
                </div>
            </a>
        </div>

        <!-- Music & Media Card -->
        <div class="col-md-5">
            <a href="/Music" class="text-decoration-none">
                <div class="card nav-card bg-dark bg-opacity-75 border-secondary text-white h-100 text-center p-4 shadow-sm" style="backdrop-filter: blur(8px);">
                    <i class="bi bi-play-circle display-4 mb-3" style="color: #a855f7;"></i>
                    <h3 class="h4 fw-bold">Music & Media</h3>
                    <p class="text-light small mb-0">Stream our music, view photos, and find upcoming show dates.</p>
                </div>
            </a>
        </div>

    </div>
</div>